# Copia este archivo como .env y completa TUS valores. Nunca lo subas a Git.
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecodrive
# En la nube (Neon/Render) descomenta la siguiente linea:
# PGSSL=require
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_LARGO_Y_ALEATORIO
ADMIN_USER=admin
ADMIN_PASS=CAMBIA_ESTA_CLAVE
THRESHOLD_ECT=105
SEVERIDAD_ALERTA=ALTA

# --- Opcionales (notificaciones e integraciones) ---
# Las alertas externas (WhatsApp/Email/SMS/Webhook) se configuran desde el
# panel en "Gestión > Alertas"; no requieren variables de entorno.
# Gmail/SMTP de respaldo (si no se define en el panel):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu@correo.com
# SMTP_PASS=clave_de_aplicacion
# ADMIN_EMAIL=hola@ecodrive.app

# Firma de webhooks salientes (HMAC-SHA256). El secreto se define por webhook
# en el panel; esta variable es solo un valor por defecto opcional.
# WEBHOOK_SECRET=

# Base pública para enlaces en notificaciones y webhooks:
# PUBLIC_BASE_URL=https://tu-dominio

